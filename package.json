{
  "name": "polaris-shadcn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "packages/*",
      "packages/config/*"
    ],
    "catalog": {
      "next": "^16.3.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "typescript": "^5.9.3",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/node": "^22.20.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "zod": "^4.6.5",
      "eslint": "^9.39.5",
      "typescript-eslint": "^8.70.1",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-config-next": "^16.3.6",
      "@eslint/js": "^9.39.5"
    },
    "catalogs": {
      "testing": {
        "vitest": "^3.2.7",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^3.2.7",
        "@testing-library/react": "^16.3.3",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/user-event": "^14.6.7",
        "jsdom": "^26.1.0",
        "msw": "^2.15.0",
        "@playwright/test": "^1.63.0"
      },
      "storybook": {
        "storybook": "^9.1.20",
        "@storybook/addon-a11y": "^9.1.20",
        "@storybook/react-vite": "^9.1.20",
        "vite": "^7.3.6"
      }
    }
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "check-types": "bun run --filter '*' check-types",
    "test": "bun run --filter '*' test",
    "test:ci": "bun run --filter '*' test:ci",
    "coverage": "bun run --filter '*' coverage",
    "storybook": "bun run --filter @repo/ui storybook",
    "storybook:build": "bun run --filter @repo/ui storybook:build",
    "e2e": "bun run --filter @repo/e2e e2e",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "catalog:",
    "@repo/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
